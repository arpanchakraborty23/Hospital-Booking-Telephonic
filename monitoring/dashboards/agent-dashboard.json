{
  "title": "Hospital Agent",
  "tags": ["hospital", "agent"],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "editable": true,
  "refresh": "10s",
  "panels": [
    {
      "gridPos": { "h": 8, "w": 3, "x": 0, "y": 0 },
      "type": "stat",
      "title": "Active Sessions",
      "targets": [
        {
          "expr": "hospital_active_sessions",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "green" },
            { "value": 5, "color": "orange" },
            { "value": 10, "color": "red" }
          ]}
        }
      }
    },
    {
      "gridPos": { "h": 8, "w": 3, "x": 3, "y": 0 },
      "type": "stat",
      "title": "Total Sessions",
      "targets": [
        {
          "expr": "hospital_total_sessions_total",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "gridPos": { "h": 8, "w": 3, "x": 6, "y": 0 },
      "type": "gauge",
      "title": "CPU Usage",
      "targets": [
        {
          "expr": "hospital_process_cpu_percent",
          "legendFormat": "CPU %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "green" },
            { "value": 50, "color": "orange" },
            { "value": 80, "color": "red" }
          ]}
        }
      }
    },
    {
      "gridPos": { "h": 8, "w": 3, "x": 9, "y": 0 },
      "type": "gauge",
      "title": "Memory Usage",
      "targets": [
        {
          "expr": "hospital_process_memory_percent",
          "legendFormat": "Memory %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "green" },
            { "value": 50, "color": "orange" },
            { "value": 80, "color": "red" }
          ]}
        }
      }
    },
    {
      "gridPos": { "h": 8, "w": 4, "x": 12, "y": 0 },
      "type": "stat",
      "title": "Memory RSS",
      "targets": [
        {
          "expr": "hospital_process_memory_rss_bytes",
          "legendFormat": "RSS",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "type": "timeseries",
      "title": "Active Sessions Over Time",
      "targets": [
        {
          "expr": "hospital_active_sessions",
          "legendFormat": "Active",
          "refId": "A"
        },
        {
          "expr": "rate(hospital_total_sessions_total[5m])",
          "legendFormat": "Rate (5m)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      }
    },
    {
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "type": "timeseries",
      "title": "STT Latency (p50 / p95 / p99)",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(hospital_stt_latency_seconds_bucket[5m]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(hospital_stt_latency_seconds_bucket[5m]))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(hospital_stt_latency_seconds_bucket[5m]))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "type": "timeseries",
      "title": "LLM TTFT (p50 / p95 / p99)",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(hospital_llm_latency_seconds_bucket[5m]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(hospital_llm_latency_seconds_bucket[5m]))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(hospital_llm_latency_seconds_bucket[5m]))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "type": "timeseries",
      "title": "TTS TTFB (p50 / p95 / p99)",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(hospital_tts_latency_seconds_bucket[5m]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(hospital_tts_latency_seconds_bucket[5m]))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(hospital_tts_latency_seconds_bucket[5m]))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "type": "timeseries",
      "title": "CPU Usage",
      "targets": [
        {
          "expr": "hospital_process_cpu_percent",
          "legendFormat": "CPU %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      }
    },
    {
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "type": "timeseries",
      "title": "Memory Usage",
      "targets": [
        {
          "expr": "hospital_process_memory_percent",
          "legendFormat": "Memory %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      }
    },
    {
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "type": "timeseries",
      "title": "Memory RSS",
      "targets": [
        {
          "expr": "hospital_process_memory_rss_bytes",
          "legendFormat": "RSS",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    }
  ]
}

{
  "title": "Hospital Application Logs",
  "tags": ["hospital", "logs"],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "editable": true,
  "refresh": "30s",
  "panels": [
    {
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "type": "stat",
      "title": "Error Rate (5m)",
      "targets": [
        {
          "expr": "sum(rate({container=~\"hospital-.+\"} | json | level=\"error\" [5m])) or vector(0)",
          "legendFormat": "Errors/s",
          "refId": "A",
          "datasource": "Loki"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "green" },
            { "value": 0.1, "color": "orange" },
            { "value": 0.5, "color": "red" }
          ]}
        }
      }
    },
    {
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "type": "stat",
      "title": "Total Logs (5m)",
      "targets": [
        {
          "expr": "sum(count_over_time({container=~\"hospital-.+\"}[5m]))",
          "legendFormat": "Logs",
          "refId": "A",
          "datasource": "Loki"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "type": "stat",
      "title": "Error Count (5m)",
      "targets": [
        {
          "expr": "sum(count_over_time({container=~\"hospital-.+\"} | json | level=\"error\" [5m]))",
          "legendFormat": "Errors",
          "refId": "A",
          "datasource": "Loki"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "green" },
            { "value": 5, "color": "orange" },
            { "value": 20, "color": "red" }
          ]}
        }
      }
    },
    {
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "type": "stat",
      "title": "Active Sessions (logs)",
      "targets": [
        {
          "expr": "count by (session_id) (sum by (session_id) (count_over_time({container=~\"hospital-.+\"} | json | session_id!=\"\" [5m])))",
          "legendFormat": "Sessions",
          "refId": "A",
          "datasource": "Loki"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "type": "stat",
      "title": "Unique Session IDs",
      "targets": [
        {
          "expr": "count(count by (session_id) ({container=~\"hospital-.+\"} | json | session_id!=\"\"))",
          "legendFormat": "Sessions",
          "refId": "A",
          "datasource": "Loki"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 4 },
      "type": "logs",
      "title": "Live Logs",
      "targets": [
        {
          "expr": "{container=~\"$container\"} | json | line_format \"{{.level}} | {{.logger}} | {{.message}}\"",
          "legendFormat": "",
          "refId": "A",
          "datasource": "Loki"
        }
      ],
      "options": {
        "showLabels": false,
        "showTime": true,
        "wrapLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "type": "timeseries",
      "title": "Log Volume by Level",
      "targets": [
        {
          "expr": "sum by (level) (count_over_time({container=~\"hospital-.+\"} | json | level=~\"error|warn|info|debug\" [$__interval]))",
          "legendFormat": "{{ level }}",
          "refId": "A",
          "datasource": "Loki"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      },
      "stack": {
        "mode": "normal"
      }
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "type": "timeseries",
      "title": "Error Rate by Service",
      "targets": [
        {
          "expr": "sum by (container) (rate({container=~\"hospital-.+\"} | json | level=\"error\" [$__interval]))",
          "legendFormat": "{{ container }}",
          "refId": "A",
          "datasource": "Loki"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "eps"
        }
      }
    },
    {
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "type": "piechart",
      "title": "Log Level Distribution",
      "targets": [
        {
          "expr": "sum(count_over_time({container=~\"hospital-.+\"} | json | level=~\"error|warn|info|debug\" [$__range]))",
          "legendFormat": "{{ level }}",
          "refId": "A",
          "datasource": "Loki"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      }
    },
    {
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "type": "table",
      "title": "Logs by Logger",
      "targets": [
        {
          "expr": "topk(10, sum by (logger) (count_over_time({container=~\"hospital-.+\"} | json | logger!=\"\" [$__range])))",
          "legendFormat": "{{ logger }}",
          "refId": "A",
          "datasource": "Loki"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "displayMode": "color-background",
            "color": { "mode": "thresholds" }
          }
        }
      }
    },
    {
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "type": "table",
      "title": "Recent Errors",
      "targets": [
        {
          "expr": "topk(20, {container=~\"hospital-.+\"} | json | level=\"error\" | json)",
          "legendFormat": "",
          "refId": "A",
          "datasource": "Loki"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "displayMode": "color-background"
          }
        }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "container",
        "type": "query",
        "query": "label_values({__name__=~\".+\"}, container)",
        "refresh": 1,
        "includeAll": true,
        "allValue": "hospital-.+",
        "datasource": "Loki",
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  }
}
